# Root Gitignore for Water Reminder Project

# OS/System files
.DS_Store
Thumbs.db
*.log
*.tmp

# Stale folders
# Anchored to the repo root on purpose: an unanchored "waterapp/" also matches
# the Kotlin source dir at android/app/src/main/kotlin/com/example/waterapp/.
/waterapp/

# Environment and Secrets (already ignored in subdirs, but added here for safety)
.env
.env.local
build-release.bat
google-services.json

# Debris
diff.txt

# AI / Assistant workspaces/logs
.commandcode/
.claude/
CLAUDE.md
todo.md
context.md
senior_dev_review.md
code_review.md
walkthrough.md
implementation_plan.md
task.md
